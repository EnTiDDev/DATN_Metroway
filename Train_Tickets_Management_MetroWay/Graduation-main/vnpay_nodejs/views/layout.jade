doctype html
html
  head
    title=title
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='/stylesheets/jumbotron-narrow.css')
    link(rel='stylesheet', href='/stylesheets/bootstrap.min.css')
  body
    div.container(style='max-width: 960px; padding: 12px')
      div.header.clearfix
        ul.nav.nav-pills.pull-right(style='display:flex; gap:8px; flex-wrap:wrap')
          li(role="presentation").active
            a(href='/order/create_payment_url') Tạo mới GD thanh toán
          li(role="presentation").active
            a(href='/order/querydr') API truy vấn kết quả thanh toán
          li(role="presentation").active
            a(href='/order/refund') API hoàn tiền giao dịch
        h3.text-muted VNPAY DEMO
      block content
      footer.footer
        p &copy; VNPAY #{new Date().getFullYear()}